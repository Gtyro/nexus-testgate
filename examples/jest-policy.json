{
  "version": 1,
  "name": "jest-phases-v1",
  "command": ["jest", "--runInBand"],
  "allow_command_override": false,
  "limits": {
    "seconds": 10,
    "output_bytes": 65536,
    "output_lines": 2000,
    "line_bytes": 4096
  },
  "timing": {
    "adapter": "jest",
    "startup_seconds": 5,
    "execution_seconds": 5
  },
  "backend": {"type": "native"},
  "checks": {}
}
